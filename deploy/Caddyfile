# HTTPS otomatis (Let's Encrypt) untuk domain di env DOMAIN.
# Uji tanpa domain (hanya HTTP, tanpa login Google/Microsoft): DOMAIN=:80
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# LJK Scanner v2 (Next.js di Vercel) dipasang di /v2 — app di-build dengan NEXT_PUBLIC_BASE_PATH=/v2
	handle /v2* {
		reverse_proxy https://ljk-scanner-v2.vercel.app {
			header_up Host {upstream_hostport}
			flush_interval -1
		}
	}
	handle {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
}
