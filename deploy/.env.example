# Salin: cp deploy/.env.example deploy/.env && chmod 600 deploy/.env  — lalu isi. Berkas .env TIDAK masuk git.

# ---- Alamat (wajib)
DOMAIN=ljk.contoh.id                      # domain yang A-record-nya menunjuk ke IP VPS. Uji tanpa domain: :80
PUBLIC_URL=https://ljk.contoh.id          # alamat publik lengkap (https). Dipakai untuk redirect login Google/Microsoft

# ---- Rahasia (wajib) — buat dengan: openssl rand -base64 32
POSTGRES_PASSWORD=
SESSION_SECRET=

# ---- Login admin. Isi SALAH SATU/KEDUANYA. Akun yang boleh masuk: ADMIN_EMAILS (default: semua ditolak)
ADMIN_EMAILS=anda@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
ADMIN_DOMAINS=                            # opsional, hanya domain Google Workspace/Microsoft (BUKAN gmail.com)
ADMIN_ALLOW_TOKEN=                         # 1 = izinkan token walau login Google/Microsoft aktif (cadangan darurat)
ADMIN_TOKEN=                              # cadangan; dinonaktifkan otomatis bila login Google/Microsoft aktif

# ---- Google Sheet (opsional). File kredensial: taruh di deploy/secrets/gsheet.toml
GSHEET_URL=
GSHEET_CREDENTIALS=/run/secrets/gsheet.toml
SYNC_SINCE=                               # opsional: hanya sinkronkan sesi yang disubmit setelah waktu ini (ISO, mis. 2026-10-01T00:00:00Z)

# ---- Performa
SCAN_WORKERS=2                            # jumlah proses pemindai ≈ jumlah vCPU (VPS 4 vCPU -> 4)
API_MEM_LIMIT=1300m                       # batas RAM kontainer API. Aturan praktis: 500 MB + 400 MB x SCAN_WORKERS (4 worker -> 2200m)
UPLOAD_RETENTION_HOURS=24

# Login admin username+password (hash: python -m server.auth hash)
ADMIN_USER=
ADMIN_PASSWORD_HASH=
