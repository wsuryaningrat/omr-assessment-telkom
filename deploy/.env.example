# Salin ke deploy/.env lalu isi. Berkas .env tidak masuk git.
POSTGRES_PASSWORD=ganti-dengan-sandi-kuat
ADMIN_TOKEN=            # cadangan; dinonaktifkan otomatis bila login Microsoft aktif. Isi: openssl rand -base64 24
SESSION_SECRET=         # WAJIB, acak & panjang: openssl rand -base64 32  (sesi admin tetap valid setelah restart)
PUBLIC_URL=https://ljk.contoh.ac.id      # alamat publik (https) — dipakai untuk redirect login Microsoft

# Login admin Microsoft (Entra ID)
MS_CLIENT_ID=
MS_TENANT_ID=           # Directory (tenant) ID berupa GUID, bukan "common"
MS_CLIENT_SECRET=
ADMIN_EMAILS=admin1@kampus.ac.id,admin2@kampus.ac.id   # akun yang boleh masuk (default: semua ditolak)
ADMIN_DOMAINS=          # opsional: seluruh domain, mis. kampus.ac.id (hati-hati: semua akun di domain itu jadi admin)

# Login admin Google (Gmail / Workspace) — bisa aktif bersamaan dengan Microsoft
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Sheet (opsional)
GSHEET_URL=
GSHEET_CREDENTIALS=
