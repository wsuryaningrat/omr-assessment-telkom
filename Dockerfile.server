FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

# libglib2.0-0 dibutuhkan OpenCV (headless)
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Jalankan sebagai pengguna biasa (bukan root)
RUN useradd --system --create-home --uid 10001 ljk && mkdir -p /data/uploads && chown -R ljk:ljk /data

WORKDIR /app
COPY server/requirements.txt server/constraints.txt server/
# constraints.txt mengunci versi yang sudah diuji -> image produksi identik dengan yang diuji
RUN pip install -r server/requirements.txt -c server/constraints.txt

COPY core core
COPY scanner scanner
COPY server server
COPY templates/omr_config.json templates/omr_config.json

USER ljk
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/api/health', timeout=4).status == 200 else 1)"

# Satu proses uvicorn; paralelisme pemindaian ada di process pool (SCAN_WORKERS), bukan jumlah proses web.
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
