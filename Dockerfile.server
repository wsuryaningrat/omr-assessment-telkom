FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY server/requirements.txt server/requirements.txt
RUN pip install -r server/requirements.txt
COPY core core
COPY scanner scanner
COPY server server
COPY templates templates
# Jumlah worker: samakan dengan jumlah core (VPS 2 CPU -> 2). Satu proses uvicorn saja;
# paralelisme pemindaian ada di process pool, bukan di jumlah proses web.
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
